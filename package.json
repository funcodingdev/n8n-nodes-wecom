{
	"name": "n8n-nodes-wecom",
	"version": "0.1.11",
	"description": "n8n community node for WeCom (WeChat Work) integration. Send messages and manage contacts.",
	"license": "MIT",
	"homepage": "https://github.com/funcodingdev/n8n-nodes-wecom",
	"keywords": [
		"n8n-community-node-package",
		"wecom",
		"wechat work",
		"enterprise wechat"
	],
	"author": {
		"name": "funcodingdev",
		"email": "funcodingdev@foxmail.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/funcodingdev/n8n-nodes-wecom.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease",
		"install:local": "./scripts/dev-install.sh",
		"uninstall:local": "./scripts/dev-uninstall.sh",
		"start:local": "./scripts/dev-start.sh"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/WeComApi.credentials.js",
			"dist/credentials/WeComWebhookApi.credentials.js",
			"dist/credentials/WeComReceiveApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/WeCom/WeCom.node.js",
			"dist/nodes/WeComTrigger/WeComTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^19.0.4",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
